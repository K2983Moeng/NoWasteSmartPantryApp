<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 1 layout: the pantry list. CoordinatorLayout lets the FAB float above the list. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Vertical stack: alert banner on top, then the list (or empty message). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Expiring-soon banner. Hidden (gone) unless the setting is on and items are expiring. -->
        <TextView
            android:id="@+id/tvAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/expiring_amber"
            android:padding="10dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- FrameLayout lets the empty message sit on top of the (empty) list. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- The scrolling list of pantry items, filled by PantryAdapter. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPantry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp"
                android:paddingBottom="88dp" />

            <!-- Friendly message when the pantry has no items. -->
            <TextView
                android:id="@+id/tvEmptyPantry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/empty_pantry"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Floating "+" button that opens the Add Ingredient screen. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/add_fab_description"
        android:src="@android:drawable/ic_input_add"
        app:tint="@color/white" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
