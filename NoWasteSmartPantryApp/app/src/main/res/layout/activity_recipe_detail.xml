<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 4 layout: full recipe detail (ingredients + method). -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Vertical stack of headings and text blocks. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Recipe name as a large heading. -->
        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/green_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Cooking time line. -->
        <TextView
            android:id="@+id/tvDetailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- "Ingredients" section heading. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/header_ingredients"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- One line per ingredient, with a tick/cross showing whether the pantry covers it. -->
        <TextView
            android:id="@+id/tvDetailIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp" />

        <!-- "Method" section heading. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/header_method"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Numbered preparation steps. -->
        <TextView
            android:id="@+id/tvDetailSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
