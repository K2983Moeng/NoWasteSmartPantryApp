<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 2 layout: the Add / Edit ingredient form. ScrollView keeps it usable with the keyboard open. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Vertical stack of form fields. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TextInputLayout shows a floating hint and the validation error text. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_name">

            <!-- The actual input. inputType capitalises each word; singleLine prevents line breaks. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLength="40"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quantity field. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_quantity">

            <!-- numberDecimal opens a numeric keyboard that allows a decimal point. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Label above the unit drop-down. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_unit"
            android:textColor="@color/text_secondary" />

        <!-- Drop-down list of units (filled in Java from the "units" string-array). -->
        <Spinner
            android:id="@+id/spUnit"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- Expiry date field. -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_expiry">

            <!-- Not focusable/typeable: tapping it opens a DatePickerDialog instead, so the format is always valid. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExpiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Removes a previously chosen expiry date. -->
        <Button
            android:id="@+id/btnClearDate"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear_date" />

        <!-- Saves the ingredient (validates first). -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/btn_save" />
    </LinearLayout>
</ScrollView>
